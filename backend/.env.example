# Copy this file to .env and fill in your values.
# Never commit .env to git.

APP_NAME=Research Intelligence
APP_VERSION=0.1.0
DEBUG=false

# PostgreSQL connection (populated in T1.3)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_intelligence

# CORS: comma-separated list of allowed origins. No wildcard.
CORS_ORIGINS=http://localhost:3000
