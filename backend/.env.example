# Copy this file to .env and fill in your values.
# Never commit .env to git.

APP_NAME=Research Intelligence
APP_VERSION=0.1.0
DEBUG=false

# Database connection (optional override; defaults to sqlite:///<BACKEND_DIR>/data/app.db)
# DATABASE_URL=sqlite:///path/to/custom/app.db

# CORS: comma-separated list of allowed origins. No wildcard.
# T2: allow_credentials=True requires explicit origins (never wildcard).
CORS_ORIGINS=http://localhost:3000
