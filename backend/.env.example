# Copy this file to .env and fill in your values.
# Never commit .env to git.

APP_NAME=Research Intelligence
APP_VERSION=0.1.0
DEBUG=false

# Database connection (optional override; defaults to sqlite:///<BACKEND_DIR>/data/app.db)
# DATABASE_URL=sqlite:///path/to/custom/app.db

# CORS: comma-separated list of allowed origins. No wildcard.
# T2: allow_credentials=True requires explicit origins (never wildcard).
CORS_ORIGINS=http://localhost:3000

# Session cookie security: set to false for local HTTP development, true in production
SESSION_COOKIE_SECURE=false

# Document upload settings (optional overrides; defaults shown)
# MAX_UPLOAD_BYTES=20971520
# MAX_PDF_PAGES=300
# MAX_DOCUMENTS_PER_PROJECT=20
# PDF_PROBE_TIMEOUT_SECONDS=10.0
# UPLOAD_DIR=data/uploads
